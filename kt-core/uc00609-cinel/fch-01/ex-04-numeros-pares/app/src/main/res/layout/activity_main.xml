<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:paddingTop="60dp">

    <Button
        android:id="@+id/btnMissao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Iniciar Missão" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Cenário -->

        <ImageView
            android:id="@+id/imgBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/cenario_nave"
            android:contentDescription="Nave Espacial" />

        <!-- Resultado -->

        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="22sp"
            android:shadowColor="#000000"
            android:shadowRadius="4" />

        <!-- Personagem -->

        <ImageView
            android:id="@+id/imgPersonagem"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="center"
            android:translationY="120dp"
            android:src="@drawable/capivara_astronauta"
            android:contentDescription="Capivara Astronauta" />

        <ImageView
            android:id="@+id/imgCarimbo"
            android:layout_width="550dp"
            android:layout_height="450dp"
            android:layout_gravity="center"
            android:translationY="-130dp"
            android:visibility="gone"
            android:src="@drawable/capivara_carimbo"
            android:contentDescription="Carimbo" />

    </FrameLayout>

</LinearLayout>