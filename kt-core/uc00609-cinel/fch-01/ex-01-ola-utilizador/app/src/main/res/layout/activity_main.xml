<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/etPrimeiroNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Primeiro Nome"
        android:inputType="text"
        android:autofillHints="name" />

    <EditText
        android:id="@+id/etUltimoNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Último Nome"
        android:inputType="text"
        android:autofillHints="familyName" />

    <Button
        android:id="@+id/btnSaudacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Saudar" />

    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:textSize="20sp" />

    <FrameLayout
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:layout_marginTop="16dp">

        <ImageView
            android:id="@+id/imgBackground"
            android:layout_width="350dp"
            android:layout_height="358dp"
            android:contentDescription="Cenário"
            android:scaleType="fitXY"
            android:translationY="-60dp"
            android:src="@drawable/capivbackground" />

        <ImageView
            android:id="@+id/imgCapivara"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center|bottom"
            android:contentDescription="Capivara"
            android:src="@drawable/capiv1" />

    </FrameLayout>

</LinearLayout>